# =============================================================================
# Эталонный vhost для БЕТЫ — flowise.dinamchiki.ru.
#
# Повторяет живой /etc/caddy/addons/flowise.conf (09.10.2026) без basicauth
# и раздела /audit. Раньше здесь лежал конфиг для SPA без пререндера: он
# отдавал главную страницу на /teams и 404 на весь раздел /sveden.
#
# Сборка пререндерена (npm run build:static): у страниц есть готовый HTML
# в {path}/index.html. Раздача повторяет боевой nginx
# (docker/nginx.dinamchiki.ru.conf).
#
# Проверка: caddy validate --config docker/Caddyfile.example --adapter caddyfile
# =============================================================================

flowise.dinamchiki.ru {
	encode gzip

	# connect-src перечисляет бета-API. При переходе на прод заменить на
	# боевой домен API — иначе браузер заблокирует запросы.
	# img-src minio — фото галереи из CRM, frame-src yandex — карта площадок.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://mc.yandex.ru https://yastatic.net; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://mc.yandex.ru https://minio.dinamchiki.ru; frame-src https://yandex.ru https://*.yandex.ru; connect-src 'self' https://apigql.dinamchiki.ru https://mc.yandex.ru; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		# Бета не должна попадать в индекс, даже если robots.txt отдали неверно.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Старые адреса раздела «Сведения».
	redir /sveden/leadership /sveden/managers 301
	redir /sveden/paid-edu /sveden/paid_edu 301
	redir /sveden/meals /sveden/catering 301

	# Хвостовой слэш — дубль страницы.
	@trailing path_regexp trailing ^(.+)/$
	redir @trailing {re.trailing.1} 301

	handle {
		root * /srv/dynamost-flowise

		# Детальные страницы, которых нет в пререндере (игроки, турниры,
		# новые группы), открывает SPA.
		@dynamic path_regexp ^/(team|coach|player|tournament)/[^/]+$
		handle @dynamic {
			try_files {path}/index.html /spa.html
			file_server
		}

		# Остальное — только готовые файлы; чего нет, то 404.
		handle {
			try_files {path} {path}/index.html
			file_server
		}

		@html not path /assets/* /og/* /favicon/* /images/* /logo/*
		header @html Cache-Control "no-cache"

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			# Иначе 404 на /assets/* унаследует «кэшировать год».
			header Cache-Control "no-cache"
			root * /srv/dynamost-flowise
			rewrite * /404.html
			file_server
		}
	}
}
