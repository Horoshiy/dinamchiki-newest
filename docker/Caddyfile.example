# =============================================================================
# Эталонный vhost для БЕТЫ — flowise.dinamchiki.ru.
# Боевые имена будут назначены при раскатке через CI/CD.
#
# Бета обслуживается Caddy (сервер отвечает `server: Caddy`),
# а не nginx из docker-compose. Раньше README, scripts/deploy.sh и
# docker/nginx.conf описывали три разных способа деплоя, ни один из которых
# не совпадал с реальностью.
#
# Проверка: caddy validate --config docker/Caddyfile.example --adapter caddyfile
# =============================================================================

flowise.dinamchiki.ru {
	root * /srv/dinamchiki-newest/dist
	encode gzip zstd

	# ВНИМАНИЕ: connect-src перечисляет бета-API. При переходе на прод
	# заменить на боевой домен API — иначе браузер заблокирует запросы,
	# и сайт молча останется без данных.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://mc.yandex.ru https://yastatic.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://mc.yandex.ru; connect-src 'self' https://apigql.dinamchiki.ru wss://apigql.dinamchiki.ru https://mc.yandex.ru; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		# Бета не должна попадать в индекс, даже если robots.txt отдали неверно.
		# На проде этот заголовок убрать.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Хешированные ассеты Vite иммутабельны.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Известные маршруты SPA отдаём с 200.
	@known path / /teams /coaches /tournaments /gallery /contacts
	@knownDetail path /team/* /coach/* /tournament/* /player/*
	handle @known {
		rewrite * /index.html
		file_server
	}
	handle @knownDetail {
		rewrite * /index.html
		file_server
	}

	# Реальные файлы: favicon, og-картинки, robots.txt, sitemap.xml.
	handle {
		file_server
	}

	# Всё остальное — честный 404 со страницей SPA.
	# Раньше SPA-fallback отдавал 200 на любой мусорный URL (soft-404),
	# и поисковик индексировал несуществующие адреса.
	handle_errors {
		@notFound expression {err.status_code} == 404
		handle @notFound {
			rewrite * /index.html
			file_server
			header Cache-Control "no-store"
		}
	}
}
