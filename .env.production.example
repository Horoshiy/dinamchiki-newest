# Боевая сборка. Скопировать в .env.production и ЗАПОЛНИТЬ РЕАЛЬНЫМИ ЗНАЧЕНИЯМИ.
# Файл попадает в Docker-образ (.dockerignore его пропускает) — vite читает
# его сам в режиме production.
#
# Здесь намеренно нет бета-адресов: если оставить их, боевой сайт будет
# ходить в бета-бэкенд и об этом никто не узнает. Сборка с индексацией
# и бета-хостом падает — см. vite-plugins/env-guard.ts.

VITE_GRAPHQL_HTTP=https://<боевой-api>/query

VITE_APP_TITLE="ДФК «Динамчики»"

# Канонический адрес боевого сайта: canonical, og:url, sitemap.xml.
VITE_SITE_URL=https://dinamchiki.ru

# На проде — true. Тогда выпускается sitemap.xml и robots.txt с Allow.
VITE_ALLOW_INDEXING=true

# Счётчик Яндекс.Метрики клуба. На бете не задавать — испортит статистику.
VITE_YM_ID=31195281

# Реальный телефон клуба (попадает в JSON-LD).
# Должен совпадать с src/shared/config/club.ts.
VITE_CLUB_PHONE=+79283200494
