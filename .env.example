# --- GraphQL ---
# Тот же адрес, что у сайта (Caddy пересылает /api/graphql в API) — как на проде
VITE_GRAPHQL_HTTP=https://flowise.dinamchiki.ru/api/graphql
# Куда пререндер шлёт запросы к API при сборке (без basic auth, в браузер не попадает)
PRERENDER_API_UPSTREAM=https://apigql.dinamchiki.ru/query

# --- Приложение ---
VITE_APP_TITLE="ДФК «Динамчики»"

# Канонический адрес сборки: canonical, og:url, sitemap.xml.
# Бета: https://flowise.dinamchiki.ru
# Прод:  https://dinamchiki.ru
VITE_SITE_URL=https://flowise.dinamchiki.ru

# Разрешить индексацию. На бете ВСЕГДА false, иначе тестовая копия
# с демо-контактами попадёт в поиск и будет конкурировать с боевым доменом.
VITE_ALLOW_INDEXING=false

# Телефон клуба — попадает в JSON-LD. Должен совпадать с src/shared/config/club.ts
VITE_CLUB_PHONE=+79283200494
